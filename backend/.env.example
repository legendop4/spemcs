# Development backend target. Vite reads these from this root file to proxy
# relative browser requests; they are not exposed to the browser bundle.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# For Neon (cloud):   postgresql+psycopg2://user:pass@host/db?sslmode=require
# For local Postgres: postgresql+psycopg2://postgres:password@localhost:5432/spemcs
DATABASE_URL='postgresql://neondb_owner:npg_A7evbHiKgu0L@ep-empty-dew-axrs5vol-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# ── Authentication ───────────────────────────────────────────
# Secret key for JWT token signing. Generate a strong random key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="your-secret-key-here"

# JWT token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# JWT signing algorithm
ALGORITHM="HS256"

# ── WebSocket ────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=10
