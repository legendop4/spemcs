# Development backend target. Vite reads these from this root file to proxy
# relative browser requests; they are not exposed to the browser bundle.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# For Neon (cloud):   postgresql+psycopg2://user:pass@host/db?sslmode=require
# For local Postgres: postgresql+psycopg2://postgres:password@localhost:5432/spemcs
#
# SECURITY: this file previously contained a real Neon connection string, including its
# password, and this file is tracked in git. That credential must be treated as compromised and
# rotated in the Neon console. Replacing it here does not remove it from git history.
DATABASE_URL="postgresql+psycopg2://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/spemcs?sslmode=require"

# ── Authentication ───────────────────────────────────────────
# Secret key for JWT token signing. Generate a strong random key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="your-secret-key-here"

# JWT token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# JWT signing algorithm
ALGORITHM="HS256"

# ── WebSocket ────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=10

# ── Endpoint security ────────────────────────────────────────
# HMAC secret for device tokens, and the shared key an endpoint presents once at enrolment.
# Both have insecure built-in defaults and MUST be set to strong random values per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DEVICE_TOKEN_SECRET="your-device-token-secret-here"
ENROLLMENT_BOOTSTRAP_KEY="your-enrollment-bootstrap-key-here"

# ── Policy signing key ───────────────────────────────────────
# Directory holding the RSA keyring used to sign exam network policies. The private key is
# generated once, on first use, and then REUSED: endpoints verify a policy against the key id
# recorded inside it, so a key that changes on restart makes every already-distributed policy
# unverifiable and stops exams from starting.
#
# Leave empty to use <backend project root>/secrets/signing_keys. Layout:
#   <dir>/keyring.json          public keys + lifecycle state (no secrets)
#   <dir>/private/<key_id>.pem  private keys (0600; see below for Windows)
#
# On Windows the POSIX file mode is advisory only - restrict this directory with NTFS ACLs so
# that only the service account and administrators can read it.
SIGNING_KEY_DIR=""

# Optional PKCS#8 passphrase for the stored private key. Empty means the key is stored
# unencrypted and protected by filesystem permissions alone. Changing this value does NOT
# re-encrypt an existing key - rotate the key (POST /api/policies/signing-key/rotate) to apply
# it. Set it through the deployment's secret store, not by committing it here.
SIGNING_KEY_PASSPHRASE=""

# Permit an in-memory signing key when no writable key directory is available.
# Keep this false everywhere except a throwaway development box: an ephemeral key makes every
# policy the process signs unverifiable as soon as it exits, and the failure surfaces as an exam
# that cannot start rather than as the configuration error it is.
SIGNING_KEY_ALLOW_EPHEMERAL=false

# ── Trusted destination resolution ───────────────────────────
# IP addresses of the DNS servers this backend trusts to turn vendor/exam destination DOMAINS
# into the IP addresses that get signed into a policy and become firewall allow rules on the
# endpoint. Comma-separated; addresses only, never names.
#
# Why this exists: the endpoint agent turns every address in a signed policy directly into an
# allow rule, so an address is a security decision. Answers from an untrusted resolver, or
# addresses supplied by an API caller, must never reach that list. Leave empty if every vendor
# profile pins explicit approved_ip_ranges - a profile that declares domains with no resolver
# configured fails policy compilation loudly instead of compiling an allowlist that omits them.
#
# These resolvers are for building policies on the server. They have nothing to do with what the
# endpoint is permitted to query during an exam.
TRUSTED_DNS_SERVERS=""

# Fall back to the backend host's own resolver when TRUSTED_DNS_SERVERS is empty.
# Keep false in production: answers would come from whatever nameserver the host happens to be
# pointed at, which is not a basis for signing an address into an examination allowlist.
POLICY_DNS_ALLOW_SYSTEM_RESOLVER=false

POLICY_DNS_TIMEOUT_SECONDS=3.0
POLICY_DNS_ATTEMPTS=2

# Caps on how far an allowlist may expand. Every resolved address becomes a firewall rule that
# must be applied at activation and undone at rollback. Exceeding a cap is an error, never a
# silent truncation - a truncated allowlist looks complete and fails unpredictably mid-exam.
# A domain that legitimately exceeds the per-domain cap is a large CDN front door that cannot be
# expressed as an allowlist; pin explicit approved_ip_ranges for it instead.
POLICY_MAX_ADDRESSES_PER_DOMAIN=32
POLICY_MAX_ADDRESSES_PER_POLICY=256

# Permit RFC 1918 / unique-local destinations, for on-premises examination servers. Set false if
# all destinations are public. Loopback, link-local (including the 169.254.169.254 cloud metadata
# address), multicast, reserved, IPv4-mapped IPv6 and the 6to4/Teredo tunnel ranges are refused
# regardless of this setting, and no prefix shorter than /8 (IPv4) or /32 (IPv6) is ever allowed.
POLICY_ALLOW_PRIVATE_DESTINATIONS=true
