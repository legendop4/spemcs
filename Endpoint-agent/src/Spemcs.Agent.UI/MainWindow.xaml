<Window x:Class="Spemcs.Agent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPEMCS Secure Examination Shield"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#CC231E18">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3D3D3D"/>
            <Setter Property="BorderBrush" Value="#E5E0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E79B25"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#3D322C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A221E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Modal Card Center Container -->
        <Border Background="#F5F3ED" CornerRadius="12" BorderBrush="#E5E0D8" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" Padding="0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.4" ShadowDepth="12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Accent Line -->
                <Border x:Name="AccentBar" Grid.Row="0" Height="0" Background="#E5E0D8"/>

                <Border Grid.Row="1" Padding="32">
                    <StackPanel>
                        <!-- Header Section -->
                        <TextBlock x:Name="HeaderTitle" Text="Pre-compliance check" FontSize="20" FontWeight="SemiBold" Foreground="#3D3D3D" Margin="0,0,0,4"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="Verifying running applications against exam policy" FontSize="13" Foreground="#8B857D" Margin="0,0,0,24" TextWrapping="Wrap"/>

                        <!-- 1. Loading & Scan Progress Panel -->
                        <StackPanel x:Name="LoadingPanel" Visibility="Visible" Margin="0,8,0,0">
                            <!-- Custom rounded progress bar wrapper -->
                            <Border Background="#E5E0D8" Height="6" CornerRadius="3" Margin="0,0,0,24">
                                <Border Background="#E79B25" CornerRadius="3" HorizontalAlignment="Left" Width="200">
                                    <!-- A static width or animation can be used, but since it's indeterminate, we'll fake it with a static color, or keep standard progress bar. Let's use a standard one for simplicity but styled. -->
                                </Border>
                            </Border>
                            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,-30,0,24" Foreground="#E79B25" Background="Transparent" BorderThickness="0" Opacity="0.8"/>
                            
                            <Border Background="#FCFBF9" BorderBrush="#E5E0D8" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" Foreground="#C87A19" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LoadingText" Text="Exam triggered by proctor. Scanning running processes." FontSize="13" Foreground="#655C53" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 3. Pre-Compliance Result Panel -->
                        <StackPanel x:Name="PreComplianceResultPanel" Visibility="Collapsed">
                            <Border x:Name="StatusBadge" Background="#FFF0F0" BorderBrush="#F8C8C8" BorderThickness="1" Padding="16,12" CornerRadius="8" Margin="0,0,0,20">
                                <TextBlock x:Name="StatusBadgeText" Text="⚠ 84 unapproved applications detected. Close them before starting the exam." FontSize="13" FontWeight="SemiBold" Foreground="#901C1C" TextWrapping="Wrap"/>
                            </Border>

                            <ListBox x:Name="SuspiciousProcessList" Height="160" Margin="0,0,0,20" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E5E0D8" BorderThickness="1" Foreground="#3D3D3D">
                                <ListBox.Resources>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5E0D8" BorderThickness="0,0,0,1" Padding="16,12" Background="#FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#901C1C" FontSize="13" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding ExecutablePath}" Foreground="#8B857D" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#FCECD4" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                                                    <TextBlock Text="Unauthorized" Foreground="#A97227" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button x:Name="PreComplianceContinueButton" Content="Continue to candidate verification" HorizontalAlignment="Right" Click="PreComplianceContinueButton_Click"/>
                        </StackPanel>

                        <!-- 4. Candidate Roll Number & Verification Panel -->
                        <StackPanel x:Name="StudentVerificationPanel" Visibility="Collapsed">
                            <TextBlock Text="CANDIDATE ROLL NUMBER" FontSize="11" FontWeight="Bold" Foreground="#8B857D" Margin="0,0,0,8"/>
                            <TextBox x:Name="RollNumberBox" Text="" Margin="0,0,0,24" TextChanged="RollNumberBox_TextChanged"/>

                            <Border Background="#FFF7ED" BorderBrush="#FFEDD5" BorderThickness="1" Padding="16,12" CornerRadius="8" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="Security &amp; proctoring notice" FontSize="12" FontWeight="SemiBold" Foreground="#C2410C" Margin="0,0,0,4"/>
                                    <TextBlock Text="Clicking begin will release full desktop access for your examination. All unauthorized applications will be actively reported in real time." FontSize="12" Foreground="#C2410C" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="VerifyStudentButton" Content="Begin monitored examination" HorizontalAlignment="Right" IsEnabled="False" Click="VerifyStudentButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
