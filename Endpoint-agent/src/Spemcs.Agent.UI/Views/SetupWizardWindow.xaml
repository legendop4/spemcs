<Window x:Class="Spemcs.Agent.UI.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPEMCS endpoint agent - first-run setup"
        WindowStartupLocation="CenterScreen"
        Width="580"
        Height="600"
        MinWidth="520"
        MinHeight="560"
        Background="#F5F3ED"
        Foreground="#3D3D3D"
        FontFamily="Segoe UI, Inter, Arial"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3D3D3D"/>
            <Setter Property="BorderBrush" Value="#E5E0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E79B25"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3D3D3D"/>
            <Setter Property="BorderBrush" Value="#E5E0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#3D3D3D"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3D322C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A221E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E79B25"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D68B15"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Endpoint setup" FontSize="20" FontWeight="SemiBold" Foreground="#3D3D3D"/>
                <TextBlock Text="Workstation lab association and identity registration" FontSize="13" Foreground="#8B857D" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#FCECD4" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                <TextBlock Text="Initial setup" FontSize="12" FontWeight="SemiBold" Foreground="#C87A19"/>
            </Border>
        </Grid>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
            <StackPanel>
                <!-- 1. Server URL -->
                <TextBlock Text="CENTRAL SERVER URL" FontSize="11" FontWeight="Bold" Foreground="#A89F91" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
                    <Button Grid.Column="1" Style="{StaticResource WarningButton}" Content="Fetch labs" Command="{Binding FetchLabsCommand}" Padding="16,10"/>
                </Grid>

                <!-- 2. Lab Selection -->
                <TextBlock Text="SELECT EXAMINATION LAB" FontSize="11" FontWeight="Bold" Foreground="#A89F91" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Labs}" SelectedItem="{Binding SelectedLab}" DisplayMemberPath="DisplayText" Margin="0,0,0,20"/>

                <!-- 3. PC Number -->
                <TextBlock Text="PC NUMBER IN LAB (e.g. 01, 12, PC-01)" FontSize="11" FontWeight="Bold" Foreground="#A89F91" Margin="0,0,0,8"/>
                <TextBox Text="{Binding PcNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24"/>

                <!-- 4. Workstation Identifier Preview -->
                <TextBlock Text="GENERATED WORKSTATION IDENTIFIER" FontSize="11" FontWeight="Bold" Foreground="#A89F91" Margin="0,0,0,8"/>
                <Border Background="#FCF3E5" BorderBrush="#F3E0C5" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding WorkstationIdentifier}" FontSize="16" FontWeight="SemiBold" Foreground="#A97227" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#C87A19" Margin="0,0,6,0"/>
                            <TextBlock Text="Auto-generated" FontSize="12" FontWeight="SemiBold" Foreground="#C87A19"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5. Status / Error Message Banner -->
                <!-- Only show if there's a status message. The viewmodel handles setting this. -->
                <Border Background="#EDF7ED" BorderThickness="0" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="Enter Central Server URL and select your Lab.">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#2E7D32" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Bar -->
        <Border Grid.Row="2" Background="#F5F3ED" BorderBrush="#E5E0D8" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Configures auto-run on Windows&#x0a;startup." FontSize="12" Foreground="#8B857D" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Register and start" Command="{Binding RegisterCommand}" IsEnabled="{Binding CanProceed}" Padding="24,12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
