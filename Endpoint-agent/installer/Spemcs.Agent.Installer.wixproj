<Project Sdk="WixToolset.Sdk/5.0.0">
  <PropertyGroup>
    <OutputName>Spemcs.Agent.Setup</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <OutputPath>dist\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>

    <!--
      ICE validation is skipped because it cannot run on this machine: the Windows Installer
      validation engine needs rights this box's system policy withholds from a normal user, and
      wix.exe reports that as `error WIX1105`, not a warning - so an unelevated `dotnet build`
      fails after having already produced a correct .msi.

      This suppresses the ICE pass only. Every WiX compile/link check still runs, and the two real
      authoring errors found while writing this file (WIX0026/WIX1044 on hand-written 8.3 names,
      WIX8601 on a bad harvest exclusion) were all reported with validation off. The package's
      contents are verified instead by .\verify-msi.ps1, which reads the built MSI's own tables.

      Remove this once the package is built on a signing/CI host where validation can run - ICE
      catches a different class of defect (component/GUID rules, sequencing) that neither the
      compiler nor verify-msi.ps1 looks at.
    -->
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>
  <ItemGroup>
    <!-- util:ServiceConfig (service restart policy) and WixShellExec (first-run wizard launch). -->
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
