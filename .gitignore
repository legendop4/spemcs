# ============================================================
# SPEMCS — Root .gitignore
# Covers: Python backend, React frontend, .NET agent, general
# ============================================================

# ── Secrets & Environment ────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx
*.p12
# .env.example is safe to commit (no secrets)

# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Python tools
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Backend logs (auto-generated at runtime)
backend/logs/

# ── Node.js / Frontend ───────────────────────────────────────
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── .NET / Endpoint Agent ────────────────────────────────────
# Build outputs
[Bb]in/
[Oo]bj/
publish/
artifacts/
TestResults/
Endpoint-agent/installer/dist/
Endpoint-agent/installer/obj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.csproj.user
launchSettings.json

# Local audit / scratch
*-baseline.txt
baseline-*.txt
api-inventory.txt
openapi.json
database/test_alerts.py

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── OS-generated ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ── Logs (general) ───────────────────────────────────────────
*.log
logs/

# ── Misc ─────────────────────────────────────────────────────
*.csv
!database/**/*.csv
*.tmp
*.bak
*.orig

# -- Build artifacts & scratch ---------------------------------
agent_binaries/
scratch/
Endpoint-agent/extracted/

# Database runtime files
*.db
*.db-shm
*.db-wal

# Database Backups
db_backup.json
